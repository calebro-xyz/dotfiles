{
  "$schema": "https://opencode.ai/config.json",
  "theme": "gruvbox",

  "formatter": {
    "biome": {}
  },

  "mcp": {
    "paper": {
      "type": "remote",
      "url": "http://127.0.0.1:29979/mcp",
      "enabled": true
    }
  },

  "mcpServers": {
    "resend": {
      "type": "command",
      "command": "npx -y resend-mcp",
      "env": {
        "RESEND_API_KEY": "re_xxxxxxxxx"
      }
    }
  },

  "model": "anthropic/claude-sonnet-4-5",
  "autoupdate": true
}
